# Settle — copy to .env and fill in what you use. Every setting is optional: without the NVIDIA
# key AI is off, without license keys Pro is off, and without Razorpay keys the Pro page still
# shows plans and "Redeem a code" works. Manual splitting always works.

# ---- AI (bill scanning + "Just say it") -------------------------------------------------------
# Get a free key at https://build.nvidia.com (Profile -> API Keys). Starts with "nvapi-".
NVIDIA_API_KEY=

# Vision model(s) that read bill photos. Comma-separate fallbacks, tried in order.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Text model(s) that turn "Cab 840 with Riya and Sam" into a split. Fast ones first.
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ---- Pro licenses -----------------------------------------------------------------------------
# Ed25519 key pair that signs Pro licenses. Generate one with:  npm run license keygen
# Keep the private key secret (it mints Pro). Changing it invalidates licenses already issued.
# The public key is derived from the private one when left empty.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
# Issue a promo / support code:  npm run license issue -- --plan pro_yearly [--days 30] [--id code-diwali]

# ---- Checkout (Razorpay one-time orders) ------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Test keys start with rzp_test_, live ones rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Prices in paise (₹49 / ₹399 / ₹999 by default). One-time passes: 30 days, 365 days, forever.
# PRO_PRICES=pro_monthly=4900,pro_yearly=39900,pro_lifetime=99900
# AI scans + describes per Pro license per day (fair use). 0 = no cap.
# PRO_AI_PER_DAY=200

# ---- Running it -------------------------------------------------------------------------------
# Behind a proxy or load balancer (Render, Fly.io, Railway, Heroku, nginx...), set this to the
# number of proxies (usually 1) so each user gets their own limits. Leave 0 when exposed directly.
# TRUST_PROXY=0
# Split deployment (app on Cloudflare Pages, this server on Render — see DEPLOY.md): the same long
# random value here and in the Pages project, so the proxy can tell this server who each visitor is.
# At least 24 characters, no spaces. Leave empty when this server is the only thing users reach.
# PROXY_SECRET=
# PORT=3000
# HOST=0.0.0.0

# ---- Tuning (optional) ------------------------------------------------------------------------
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per attempt. A whole scan, fallbacks included, always ends within 80 seconds; a describe within 30.
# NVIDIA_TIMEOUT_MS=35000
# NVIDIA_TEXT_TIMEOUT_MS=15000
# Free AI calls (scans + describes) per address per window.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=600000
# Scans (and, separately, describes) handled at the same time. 0 = no limit.
# MAX_CONCURRENT_SCANS=8
# Billing calls (order, verify, license check) per address per 10 minutes. 0 = no limit.
# BILLING_RATE_LIMIT_MAX=30
