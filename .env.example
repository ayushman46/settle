# Get a free key at https://build.nvidia.com (Profile -> API Keys). Starts with "nvapi-".
NVIDIA_API_KEY=

# Vision model(s) used to read bills. Comma-separate to add fallbacks, tried in order.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,google/gemma-4-31b-it,meta/llama-3.2-90b-vision-instruct

# Behind a proxy or load balancer (Render, Fly.io, Railway, Heroku, nginx...), set this to the
# number of proxies (usually 1) so each user gets their own scan limit. Leave 0 when exposed directly.
# TRUST_PROXY=0

# Optional
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per model attempt. A whole scan, fallbacks included, always ends within 80 seconds.
# NVIDIA_TIMEOUT_MS=35000
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=600000
# Scans read at the same time (0 = no limit).
# MAX_CONCURRENT_SCANS=8
# PORT=3000
# HOST=0.0.0.0
