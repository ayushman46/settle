{
  "name": "settle",
  "private": true,
  "version": "2.0.0",
  "description": "Split anything and settle in a tap: AI bill splitting, groups and one UPI pay link for everyone. No sign-up, no ads, no database.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr server/index.ts --outDir dist/server --emptyOutDir",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b && tsc -p e2e/tsconfig.json && tsc -p functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "license": "node scripts/license.mjs",
    "e2e": "playwright test",
    "e2e:ui-less": "playwright test --reporter=line",
    "e2e:report": "playwright show-report",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
