# Cloudflare Pages response headers (the Node server ignores this file).
# The same security headers the Node server sends (server/web.ts); server/pagesConfig.test.ts
# fails when the two drift apart. /api/* answers come from the Node server through
# functions/api/[[path]].ts with the server's own headers — these rules never touch them.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.razorpay.com; font-src 'self' data:; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; media-src 'self' blob:; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-src https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(self "https://api.razorpay.com" "https://checkout.razorpay.com"), usb=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: off
  X-Download-Options: noopen
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0

# Hashed build files never change: phones keep them for a year. Everything else (pages,
# sw.js, the manifest) keeps Cloudflare's default: revalidate on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
